# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini AI (Required for Natural Language Search)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Instructions:
# 1. Copy this file to .env.local (or add to your .env)
# 2. Replace the placeholder values with your actual keys
# 3. Get Gemini API key from: https://makersuite.google.com/app/apikey
# 4. Never commit .env.local to version control
# 5. All variables must be prefixed with VITE_ to be accessible in client code
