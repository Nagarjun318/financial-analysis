# Neon Auth + Data API (public; secured via JWT + RLS)
VITE_NEON_AUTH_URL=https://your-endpoint.neonauth.<region>.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://your-endpoint.apirest.<region>.aws.neon.tech/neondb/rest/v1
# Optional single-URL form (SDK derives Auth + Data API URLs from it):
# VITE_NEON_URL=https://your-endpoint.<region>.aws.neon.tech/neondb

# Phase 4: the `api` Function holds provider keys server-side. The browser
# bundle only needs the Function URL — no provider secrets ship to clients.
VITE_FUNCTION_URL=https://<branch-id>-api.compute.<cell>.<region>.aws.neon.tech

# --- Function server env (read by `neon deploy --env .env`, never bundled) ---
# IndianAPI.in key for Stock/ETF/Mutual Fund tracking (server-only)
INDIAN_API_KEY=your_indian_api_key_here
# Google Cloud key for Weather + Geocoding (server-only)
GOOGLE_API_KEY=your_google_api_key_here
# Gemini key used only when branch AI Gateway credentials are absent
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: extra browser origins for Function CORS (defaults cover
# localhost + *.github.io). Example: ALLOWED_ORIGINS=https://app.example.com

# --- Legacy client keys (local-dev fallback only, NOT shipped in prod builds) ---
# The deployed app uses VITE_FUNCTION_URL above. These remain only so `vite`
# dev works before the Function is deployed. CI does not inject them.
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
# VITE_INDIAN_API_KEY=your_indian_api_key_here

# Instructions:
# 1. Copy this file to .env.local (or add to your .env)
# 2. Replace the placeholder values with your actual keys
# 3. Run `neon deploy --env .env` to provision the Function + AI Gateway
# 4. Get the Function URL via `neon functions get api` and set VITE_FUNCTION_URL
#    (locally in .env, and as the FUNCTION_URL secret for Pages builds)
# 5. Get Gemini API key from: https://makersuite.google.com/app/apikey
# 6. Get IndianAPI.in key from: https://stock.indianapi.in
# 7. Never commit .env.local to version control
